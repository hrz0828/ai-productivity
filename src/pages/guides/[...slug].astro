---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticlePageData, getArticleStaticPaths } from '../../utils/articleRoute';

export const getStaticPaths = () => getArticleStaticPaths('guides');

const { entry } = Astro.props;
const { Content, headings, related } = await getArticlePageData(entry, 'guides');
---
<ArticleLayout entry={entry} collection="guides" headings={headings} body={entry.body ?? ''} related={related}>
  <Content />
</ArticleLayout>
