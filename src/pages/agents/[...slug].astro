---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticlePageData, getArticleStaticPaths } from '../../utils/articleRoute';

export const getStaticPaths = () => getArticleStaticPaths('agents');

const { entry } = Astro.props;
const { Content, headings, related } = await getArticlePageData(entry, 'agents');
---
<ArticleLayout entry={entry} collection="agents" headings={headings} body={entry.body ?? ''} related={related}>
  <Content />
</ArticleLayout>
