---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topics } from '../../data/topics';
---

<BaseLayout title="AI 生产力专题总览：按角色与任务系统学习" description="浏览 AI 写作、产品经理、编程、知识管理、设计评审、PPT、会议、自动化、Agent、多模态和内容站专题，按任务选择系统阅读路径。" canonical="/topics/">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <header>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">Topics</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">AI 生产力专题总览</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">专题把分散的 Prompt、Skill、Agent、工具教程和完整工作流组织成学习路径。按你的角色或当前任务进入一个专题，从核心方法开始，再逐步完成实践。</p>
    </header>

    <div class="mt-10 flex flex-wrap gap-2" aria-label="专题快捷导航">
      {topics.map((topic) => <a href={`#${topic.slug}`} class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-sky-200 hover:text-sky-700">{topic.title.replace('专题', '')}</a>)}
    </div>

    <section class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="全部专题">
      {topics.map((topic, index) => (
        <article id={topic.slug} class="scroll-mt-24 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-sky-200 hover:shadow-lg">
          <div class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-700">Topic {String(index + 1).padStart(2, '0')}</div>
          <h2 class="mt-3 text-2xl font-bold text-slate-950"><a href={`/topics/${topic.slug}/`} class="hover:text-sky-700">{topic.title}</a></h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{topic.intro}</p>
          <div class="mt-5 border-t border-slate-100 pt-4">
            <div class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">适合处理</div>
            <ul class="mt-2 space-y-1.5">
              {topic.tasks.slice(0, 2).map((task) => <li class="text-sm leading-6 text-slate-600">· {task}</li>)}
            </ul>
          </div>
          <a href={`/topics/${topic.slug}/`} class="mt-5 inline-flex text-sm font-semibold text-sky-700 hover:text-sky-900">查看阅读路径与文章 →</a>
        </article>
      ))}
    </section>
  </section>
</BaseLayout>
