---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactArticleLink from '../components/CompactArticleLink.astro';
import FeatureCard from '../components/FeatureCard.astro';
import SearchEntry from '../components/SearchEntry.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TaskCard from '../components/TaskCard.astro';
import { COLLECTION_LABELS } from '../config';
import { hotSearchKeywords } from '../data/taskFinder';
import { topics } from '../data/topics';
import { getAllPublishedEntries, isIndexable } from '../utils/content';
import { itemListJsonLd, organizationJsonLd, websiteJsonLd } from '../utils/seo';

const allEntries = await getAllPublishedEntries();
const entries = allEntries.filter((entry) => isIndexable(entry.data));
const getEntryHref = (entry: (typeof entries)[number]) => `/${entry.collection}/${entry.id}/`;
const entriesByHref = new Map(entries.map((entry) => [getEntryHref(entry), entry]));
const heroSearchKeywords = hotSearchKeywords.slice(0, 6);
const homeTitle = 'AI 提示词、Agent 与工作流实战库｜按任务提升生产力';
const homeDescription = 'STS2Hub 按写作、PPT、产品、编程、知识管理和内容创作等真实任务，整理可复制的 AI 提示词、Agent 配置、自动化工作流和 AI 工具教程。';

const popularTasks = [
  { title: '写一份结构化周报', description: '把零散工作记录整理成重点、进展、风险和下周计划。', href: '/prompts/ai-weekly-report-prompt/', label: '职场写作', meta: '入门' },
  { title: '从需求想法生成 PRD', description: '澄清用户、目标与边界，形成可进入评审的需求文档。', href: '/workflows/write-prd-with-ai/', label: '产品工作', meta: '进阶' },
  { title: '整理会议纪要和行动项', description: '从记录中提取结论、负责人、期限和待确认问题。', href: '/workflows/meeting-to-action-items/', label: '团队协作', meta: '入门' },
  { title: '完成一次竞品分析', description: '确定分析维度，整理证据、差异、机会点和汇报结构。', href: '/workflows/competitive-analysis-with-ai/', label: '研究分析', meta: '进阶' },
  { title: '用 AI 做代码审查', description: '按正确性、安全性、可维护性和测试缺口检查代码。', href: '/workflows/code-review-with-ai/', label: 'AI 编程', meta: '进阶' },
  { title: '搭建个人知识库', description: '连接资料收集、摘要、标签、归档和定期复盘流程。', href: '/workflows/personal-knowledge-base-with-ai/', label: '知识管理', meta: '进阶' },
];
const heroRecommendations = popularTasks.slice(0, 4);

const playbookHrefs = [
  '/workflows/seo-article-with-ai/',
  '/workflows/write-prd-with-ai/',
  '/workflows/meeting-to-action-items/',
  '/workflows/code-review-with-ai/',
  '/workflows/personal-knowledge-base-with-ai/',
];
const featuredPlaybooks = playbookHrefs.map((href) => entriesByHref.get(href)).filter((entry): entry is (typeof entries)[number] => Boolean(entry));
const mainPlaybook = featuredPlaybooks[0] ?? entries.find((entry) => entry.data.featured);
const supportingPlaybooks = featuredPlaybooks.filter((entry) => entry !== mainPlaybook).slice(0, 4);

const resourcePacks = [
  { title: '高频 Prompt 起步包', description: '从周报、邮件、PRD、PPT 大纲等高频任务中选择可复制模板。', href: '/prompts/', eyebrow: 'Prompt collection' },
  { title: '端到端工作流策划包', description: '按输入、执行步骤、人工检查点和最终产出浏览完整任务路径。', href: '/workflows/', eyebrow: 'Workflow collection' },
  { title: 'Agent 角色配置包', description: '查看产品、研究、会议与内容等场景的角色目标、流程和边界。', href: '/agents/', eyebrow: 'Agent collection' },
  { title: '专题学习路径包', description: '把分散的模板、工具和工作流串成可连续阅读的成熟专题。', href: '/topics/', eyebrow: 'Topic collection' },
];
const coreTopics = topics.slice(0, 6);
const stats = [
  { value: `${entries.length}+`, label: '可索引原创内容' },
  { value: `${Object.keys(COLLECTION_LABELS).length}`, label: '专业内容栏目' },
  { value: `${topics.length}`, label: '系统化专题' },
];
const jsonLdEntries = [mainPlaybook, ...supportingPlaybooks].filter((entry): entry is (typeof entries)[number] => Boolean(entry));
const jsonLd = [
  websiteJsonLd(),
  organizationJsonLd(),
  itemListJsonLd(jsonLdEntries.map((entry) => ({ label: entry.data.title, description: entry.data.description, href: getEntryHref(entry) }))),
];
---

<BaseLayout title={homeTitle} description={homeDescription} canonical="/" jsonLd={jsonLd}>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden border-b border-slate-200 bg-white">
    <div class="absolute inset-x-0 top-0 h-72 bg-gradient-to-b from-sky-50 to-white" aria-hidden="true"></div>
    <div class="site-container relative py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">AI Productivity Playbooks</p>
          <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">把 AI 用进真实工作，而不只是聊几个概念</h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">按任务查找经过整理的 Prompt、Agent、工具教程与完整工作流。明确输入、执行步骤、产出格式和人工复核边界，直接开始实践。</p>
          <div class="mt-7 max-w-2xl"><SearchEntry /></div>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-slate-500">热门：</span>
            {heroSearchKeywords.map((keyword) => <a href={`/search/?q=${encodeURIComponent(keyword)}`} class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:border-sky-200 hover:text-sky-700">{keyword}</a>)}
          </div>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/tasks/" class="button-primary">按任务开始</a>
            <a href="/resources/" class="button-secondary">浏览资源中心</a>
          </div>
        </div>
        <aside class="rounded-3xl border border-slate-200 bg-slate-950 p-5 text-white shadow-xl sm:p-6" aria-label="推荐任务">
          <div class="flex items-end justify-between gap-4">
            <div><p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-300">Recommended this week</p><h2 class="mt-2 text-xl font-semibold">从一个明确产出开始</h2></div>
            <a href="/tasks/" class="shrink-0 text-sm font-semibold text-sky-300 hover:text-white">全部任务 →</a>
          </div>
          <div class="mt-5 grid gap-2 sm:grid-cols-2">
            {heroRecommendations.map((item, index) => <a href={item.href} class="rounded-xl border border-white/10 bg-white/5 p-4 transition hover:border-sky-300/40 hover:bg-white/10"><span class="text-xs font-semibold text-sky-300">0{index + 1} · {item.label}</span><span class="mt-2 block text-sm font-semibold leading-6 text-white">{item.title}</span></a>)}
          </div>
          <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-white/10 pt-5">
            {stats.map((stat) => <div><dt class="text-xs leading-5 text-slate-400">{stat.label}</dt><dd class="mt-1 text-xl font-bold text-white">{stat.value}</dd></div>)}
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- 2. Popular Tasks -->
  <section class="section-block bg-slate-50"><div class="site-container">
    <SectionHeader eyebrow="Popular Tasks" title="先选任务，再选 AI 方法" description="六个高频工作场景均指向现有的实战页面；从预期产出出发，比先纠结工具或术语更有效。" href="/tasks/" linkLabel="查看全部任务" />
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{popularTasks.map((task) => <TaskCard {...task} />)}</div>
  </div></section>

  <!-- 3. Featured Playbooks -->
  <section class="section-block border-y border-slate-200 bg-white"><div class="site-container">
    <SectionHeader eyebrow="Featured Playbooks" title="编辑精选实战路径" description="精选可执行、可复核、可继续扩展的工作方法。主路径负责建立完整框架，辅助阅读解决相邻任务。" href="/workflows/" linkLabel="浏览全部工作流" />
    {mainPlaybook && <div class="mt-8 grid gap-7 lg:grid-cols-[1.15fr_0.85fr]">
      <FeatureCard title={mainPlaybook.data.title} description={mainPlaybook.data.description} href={getEntryHref(mainPlaybook)} eyebrow="本期主编推荐" linkLabel="阅读完整 Playbook" />
      <div class="rounded-3xl border border-slate-200 bg-slate-50 px-5 py-2 sm:px-6">{supportingPlaybooks.map((entry) => <CompactArticleLink title={entry.data.title} description={entry.data.description} href={getEntryHref(entry)} type={COLLECTION_LABELS[entry.collection]} />)}</div>
    </div>}
  </div></section>

  <!-- 4. Resource Packs -->
  <section class="section-block bg-slate-50"><div class="site-container">
    <SectionHeader eyebrow="Resource Packs" title="四个已整理的资源策划包" description="这些入口组织本站已有页面，不提供虚构下载。根据你要复用的内容形态，进入对应集合继续筛选。" href="/resources/" linkLabel="进入资源中心" />
    <div class="mt-8 grid gap-5 md:grid-cols-2">{resourcePacks.map((pack) => <FeatureCard {...pack} linkLabel="查看现有资源" />)}</div>
  </div></section>

  <!-- 5. Core Topics -->
  <section class="section-block border-y border-slate-200 bg-white"><div class="site-container">
    <SectionHeader eyebrow="Core Topics" title="六个成熟专题" description="专题将 Prompt、Agent、工具与工作流组织为连续阅读路径，适合围绕一个专业方向系统实践。" href="/topics/" linkLabel="查看全部专题" />
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{coreTopics.map((topic) => <article class="group relative rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-sky-200"><p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-700">Topic</p><h2 class="mt-3 text-xl font-semibold text-slate-950 group-hover:text-sky-700"><a href={`/topics/${topic.slug}/`} class="after:absolute after:inset-0">{topic.title}</a></h2><p class="mt-3 text-sm leading-6 text-slate-600">{topic.description}</p><span class="mt-5 inline-flex text-sm font-semibold text-slate-700" aria-hidden="true">进入专题 →</span></article>)}</div>
  </div></section>

  <!-- 6. Trust / Editorial -->
  <section class="section-block bg-slate-950 text-white"><div class="site-container">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div><p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">Trust & Editorial</p><h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">专业内容需要方法，也需要边界</h2><p class="mt-5 text-base leading-8 text-slate-300">STS2Hub 围绕真实任务组织内容，说明适用场景、执行步骤和检查方式。AI 输出可以加速初稿，但事实、数据、权限与公开发布始终需要人工负责。</p><a href="/about/" class="mt-6 inline-flex text-sm font-semibold text-sky-300 hover:text-white">了解本站与编辑原则 →</a></div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><h3 class="font-semibold text-white">真实任务优先</h3><p class="mt-2 text-sm leading-6 text-slate-300">先定义读者要完成的产出，再选择 Prompt、工具或自动化路径。</p></div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><h3 class="font-semibold text-white">人工复核清晰</h3><p class="mt-2 text-sm leading-6 text-slate-300">标明事实核验、隐私、权限、高风险动作和公开发布的检查点。</p></div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-5"><h3 class="font-semibold text-white">持续维护内容</h3><p class="mt-2 text-sm leading-6 text-slate-300">围绕成熟专题更新教程与工作流，减少薄内容和重复信息。</p></div>
      </div>
    </div>
  </div></section>
</BaseLayout>
