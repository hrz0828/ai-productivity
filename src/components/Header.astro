---
import { NAV_ITEMS, SITE } from '../config';
---

<header class="site-header">
  <div class="site-container flex h-16 items-center justify-between gap-4">
    <a href="/" class="site-logo" aria-label={`${SITE.name} 首页`}>
      <span class="site-logo__mark" aria-hidden="true">AI</span>
      <span class="truncate">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主导航">
      {NAV_ITEMS.map((item) => (
        <a class="nav-link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="ml-auto hidden shrink-0 items-center gap-2 sm:flex">
      <a href="/search/" class="button-secondary" aria-label="搜索站内内容">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
        搜索
      </a>
      <a href="/tasks/" class="button-primary">按任务开始</a>
    </div>

    <button class="menu-toggle lg:hidden" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">打开导航菜单</span>
      <svg class="menu-icon h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="close-icon hidden h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"></path></svg>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden lg:hidden">
    <nav class="site-container py-4" aria-label="移动端导航">
      <div class="grid gap-1">
        {NAV_ITEMS.map((item) => (
          <a class="mobile-nav-link" href={item.href}>{item.label}</a>
        ))}
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3 border-t border-slate-200 pt-4">
        <a href="/search/" class="button-secondary justify-center">搜索</a>
        <a href="/tasks/" class="button-primary justify-center">按任务开始</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');

  if (menuButton && mobileMenu) {
    const setMenu = (open: boolean) => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.querySelector('.sr-only')!.textContent = open ? '关闭导航菜单' : '打开导航菜单';
      menuButton.querySelector('.menu-icon')?.classList.toggle('hidden', open);
      menuButton.querySelector('.close-icon')?.classList.toggle('hidden', !open);
      mobileMenu.classList.toggle('hidden', !open);
    };

    menuButton.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
    mobileMenu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuButton.focus();
      }
    });
  }
</script>
