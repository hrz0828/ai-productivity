---
interface Props {
  title: string;
  href: string;
  type?: string;
  description?: string;
}

const { title, href, type, description } = Astro.props;
---

<article class="group border-b border-slate-200 py-4 last:border-b-0">
  <div class="flex items-start justify-between gap-5">
    <div class="min-w-0">
      {type && <p class="mb-1 text-xs font-semibold text-sky-700">{type}</p>}
      <h3 class="font-semibold leading-6 text-slate-950"><a class="hover:text-sky-700" href={href}>{title}</a></h3>
      {description && <p class="mt-1 line-clamp-2 text-sm leading-6 text-slate-600">{description}</p>}
    </div>
    <span class="mt-1 shrink-0 text-slate-400 transition-transform group-hover:translate-x-1 group-hover:text-sky-700" aria-hidden="true">→</span>
  </div>
</article>
