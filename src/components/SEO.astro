---
import { SITE } from '../config';
import { absoluteUrl } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  imageAlt?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  image = '/images/og/default.png',
  type = 'website',
  jsonLd,
  robots = 'index,follow',
  publishedTime,
  modifiedTime,
  imageAlt,
} = Astro.props;

const pageTitle = title.includes(SITE.name) ? title : `${title} - ${SITE.name}`;
const canonicalUrl = absoluteUrl(canonical);
const imageUrl = absoluteUrl(image);
const socialImageAlt = imageAlt ?? `${pageTitle} 封面图`;
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const alternateName = SITE.alternateName ? `${SITE.name}（${SITE.alternateName}）` : SITE.name;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="author" content={SITE.author} />
<meta name="application-name" content={SITE.name} />
<meta name="apple-mobile-web-app-title" content={alternateName} />
<meta name="theme-color" content="#0284c7" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="format-detection" content="telephone=no" />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={absoluteUrl('/rss.xml')} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={socialImageAlt} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={socialImageAlt} />
{jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
