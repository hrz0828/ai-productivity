---
interface Props {
  title: string;
  description: string;
  href: string;
  eyebrow?: string;
  linkLabel?: string;
}

const { title, description, href, eyebrow, linkLabel = '查看内容' } = Astro.props;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sky-700">{eyebrow}</p>}
  <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-950 sm:text-3xl">
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </h2>
  <p class="mt-4 max-w-xl text-base leading-7 text-slate-600">{description}</p>
  <span class="mt-auto pt-7 text-sm font-semibold text-sky-700" aria-hidden="true">{linkLabel} <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
</article>
