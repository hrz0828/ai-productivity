---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/seo';

type Entry = CollectionEntry<'prompts'> | CollectionEntry<'skills'> | CollectionEntry<'agents'> | CollectionEntry<'tools'> | CollectionEntry<'workflows'> | CollectionEntry<'guides'>;

interface Props {
  entry: Entry;
  collection: string;
}

const { entry, collection } = Astro.props;
const href = `/${collection}/${entry.id}/`;
const typeLabels: Record<string, string> = {
  prompts: 'Prompt · 可复制模板',
  skills: 'Skill · 可复用能力',
  agents: 'Agent · 角色配置',
  tools: 'Tool · 工具教程',
  workflows: 'Workflow · 完整流程',
  guides: 'Guide · 方法指南',
};
const typeLabel = typeLabels[collection] ?? collection;
const displayDate = entry.data.updatedDate ?? entry.data.pubDate;
const dateLabel = entry.data.updatedDate ? '更新于' : '发布于';
---

<article class="group relative flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-slate-300 sm:p-6">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-medium text-slate-500">
    <span class="text-sky-700">{typeLabel}</span>
    <span aria-hidden="true" class="text-slate-300">/</span>
    <span>{entry.data.category}</span>
  </div>
  <h2 class="mt-3 text-xl font-semibold leading-snug tracking-tight text-slate-950 group-hover:text-sky-700">
    <a href={href} class="after:absolute after:inset-0">{entry.data.title}</a>
  </h2>
  <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">{entry.data.description}</p>
  <div class="mt-auto flex flex-wrap items-end justify-between gap-3 pt-5">
    <div class="relative z-10 flex flex-wrap gap-2">
      {entry.data.tags.slice(0, 2).map((tag) => (
        <a href={`/tags/${encodeURIComponent(tag)}/`} class="rounded-md bg-slate-100 px-2 py-1 text-xs text-slate-600 hover:bg-sky-50 hover:text-sky-700">#{tag}</a>
      ))}
    </div>
    <time class="text-xs text-slate-500" datetime={displayDate.toISOString()}>{dateLabel} {formatDate(displayDate)}</time>
  </div>
</article>
