---
interface Props {
  title: string;
  description: string;
  href: string;
  label?: string;
  meta?: string;
}

const { title, description, href, label = '任务指南', meta } = Astro.props;
---

<article class="group relative flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-sky-200 sm:p-6">
  <div class="flex items-center justify-between gap-3 text-xs font-semibold text-slate-500">
    <span class="text-sky-700">{label}</span>
    {meta && <span>{meta}</span>}
  </div>
  <h2 class="mt-3 text-lg font-semibold leading-snug text-slate-950 group-hover:text-sky-700">
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </h2>
  <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
  <span class="mt-auto pt-5 text-sm font-semibold text-slate-700" aria-hidden="true">开始执行 →</span>
</article>
