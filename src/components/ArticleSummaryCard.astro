---
import type { CollectionEntry } from 'astro:content';
import { COLLECTION_LABELS } from '../config';
import { getReadingTime } from '../utils/readingTime';
import type { CollectionName } from '../utils/content';

type Entry = CollectionEntry<'prompts'> | CollectionEntry<'skills'> | CollectionEntry<'agents'> | CollectionEntry<'tools'> | CollectionEntry<'workflows'> | CollectionEntry<'guides'>;

interface Props {
  entry: Entry;
  collection: CollectionName;
  body: string;
}

const { entry, collection, body } = Astro.props;
const outcomeByCollection: Record<CollectionName, string> = {
  prompts: '可直接调整并使用的 Prompt 模板',
  skills: '可复用的 AI 能力模块与质量标准',
  agents: '可配置的助手角色与使用边界',
  tools: '工具上手路径、适用场景与避坑建议',
  workflows: '从输入到复核的完整执行流程',
  guides: '主题判断框架与可执行建议',
};
const summaryItems = [
  { label: '主题', value: entry.data.category },
  { label: '内容类型', value: COLLECTION_LABELS[collection] },
  { label: '阅读时间', value: getReadingTime(body) },
  { label: '你将获得', value: outcomeByCollection[collection] },
];
---

<section class="mt-5 rounded-2xl border border-sky-100 bg-sky-50/60 px-5 py-4" aria-labelledby="article-value-summary">
  <h2 id="article-value-summary" class="text-sm font-semibold text-sky-900">本文速览</h2>
  <dl class="mt-3 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
    {summaryItems.map((item) => (
      <div class="grid grid-cols-[5rem_1fr] gap-2 border-t border-sky-100 pt-3 first:border-t-0 first:pt-0 sm:first:border-t sm:first:pt-3">
        <dt class="font-medium text-slate-500">{item.label}</dt>
        <dd class="font-medium leading-6 text-slate-900">{item.value}</dd>
      </div>
    ))}
  </dl>
</section>
