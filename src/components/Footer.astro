---
import { SITE, TOPIC_ITEMS } from '../config';

const corePaths = [
  { label: '按任务查找', href: '/tasks/' },
  { label: 'Prompt 模板', href: '/prompts/' },
  { label: 'Workflow 流程', href: '/workflows/' },
  { label: 'AI 工具指南', href: '/tools/' },
  { label: '专题集合', href: '/topics/' },
  { label: '资源中心', href: '/resources/' },
];
const featuredTopics = TOPIC_ITEMS.slice(0, 6);
const trustLinks = [
  { label: '关于我们', href: '/about/' },
  { label: '编辑原则', href: '/editorial-policy/' },
  { label: '内容反馈', href: '/feedback/' },
  { label: '联系我们', href: '/contact/' },
  { label: '隐私政策', href: '/privacy-policy/' },
  { label: '使用条款', href: '/terms/' },
];
---

<footer class="border-t border-slate-200 bg-slate-950 text-slate-300">
  <div class="site-container py-12 sm:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-3 font-semibold text-white" aria-label={`${SITE.name} 首页`}>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-sky-400 text-sm font-bold text-slate-950" aria-hidden="true">AI</span>
          <span>{SITE.name}</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-7 text-slate-400">面向知识工作者的 AI 实战媒体。提供经过整理的 Prompt、Workflow、工具指南和任务解决方案。</p>
        <p class="mt-5 text-xs leading-5 text-slate-500">内容强调可执行性、来源透明与持续更新。</p>
      </div>

      <nav aria-labelledby="footer-core">
        <h2 id="footer-core" class="text-sm font-semibold text-white">核心路径</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {corePaths.map((item) => <li><a class="footer-link" href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-labelledby="footer-topics">
        <h2 id="footer-topics" class="text-sm font-semibold text-white">精选专题</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {featuredTopics.map((item) => <li><a class="footer-link" href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-labelledby="footer-trust">
        <h2 id="footer-trust" class="text-sm font-semibold text-white">信任与透明</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {trustLinks.map((item) => <li><a class="footer-link" href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>
  <div class="border-t border-slate-800">
    <div class="site-container flex flex-col gap-2 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {SITE.name}. 保留所有权利。</p>
      <a class="footer-link" href="/rss.xml">RSS 订阅</a>
    </div>
  </div>
</footer>
