---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{items.length > 0 && (
  <aside class="rounded-2xl border border-slate-200 bg-white" aria-label="文章目录">
    <details class="group lg:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 font-semibold text-slate-950">
        文章目录
        <span aria-hidden="true" class="text-slate-400 transition group-open:rotate-45">＋</span>
      </summary>
      <ol class="space-y-2 border-t border-slate-100 px-5 py-4 text-sm leading-6 text-slate-600">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'pl-4' : ''}><a class="hover:text-sky-700" href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ol>
    </details>
    <div class="hidden p-5 lg:block">
      <div class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">本页目录</div>
      <ol class="mt-4 space-y-2 border-l border-slate-200 text-sm leading-6 text-slate-600">
        {items.map((heading) => (
          <li class={heading.depth === 3 ? 'pl-7' : 'pl-4'}><a class="block border-l-2 border-transparent hover:border-sky-500 hover:text-sky-700" href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ol>
    </div>
  </aside>
)}
